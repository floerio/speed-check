{
  "title": "Speed Test Monitor",
  "uid": "speedtest-monitor",
  "tags": ["speedtest", "network"],
  "timezone": "",
  "schemaVersion": 30,
  "version": 5,
  "refresh": "1m",
  "panels": [
    {
      "title": "Download Speed",
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "P1DED9D3A955C8195"
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp as time, download/1000000.0 as value FROM results WHERE timestamp >= $__from/1000 AND timestamp <= $__to/1000 ORDER BY timestamp",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "lastNotNull", "max", "min"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
